                "mcp_server_ids": [],
                "native_mcp_server_ids": [],
                "knowledge_base": [],
                "speech_engine": null,
                "ignore_default_personality": false,
                "rag": {
                    "enabled": false,
                    "embedding_model": "e5_mistral_7b_instruct",
                    "optional_rag_enabled": false,
                    "max_vector_distance": 0.6,
                    "max_documents_length": 50000,
                    "max_retrieved_rag_chunks_count": 20
                },
                "backup_llm_config": {
                    "preference": "default"
                },
                "cascade_timeout_seconds": 8,
                "tools": [
                    {
                        "type": "webhook",
                        "name": "save_call_result",
                        "description": "Persist the outcome of the scheduling call to the Intoxalock backend. Call this exactly once, right before closing the call, after you have either (a) verbally confirmed an agreed slot, or (b) collected the shop's own suggested availability, or (c) determined the call cannot proceed. Pass empty strings for any field that does not apply.",
                        "response_timeout_secs": 20,
                        "disable_interruptions": false,
                        "force_pre_tool_speech": false,
                        "pre_tool_speech": "auto",
                        "assignments": [],
