                                    },
                                    "shop_suggested_slot_2": {
                                        "type": "string",
                                        "description": "A second availability the shop proposed, as a backup for the customer. Empty string if the shop only gave one option or confirmed a customer slot.",
                                        "is_system_provided": false,
                                        "dynamic_variable": "",
                                        "allowed_values_dynamic_variable": "",
                                        "constant_value": "",
                                        "is_omitted": false
                                    }
                                }
