                <mxCell id="title" value="Intoxalock Device Removal — How an appointment gets scheduled today (and where it breaks)" style="text;html=1;fontSize=16;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="60" y="14" width="1180" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="goalBox" value="🎯  GOAL — fix a poor customer experience&#xa;Turn an ambiguous, manual, drop-prone request into a clear, reliably-confirmed appointment:&#xa;• Clarity — customer always knows request vs. confirmed appointment; never turned away at the shop&#xa;• Reliability — no silent drops; unanswered centers are followed up until resolved (not &quot;one-and-done&quot;)&#xa;• Speed — confirmed in a predictable, short timeframe&#xa;• Less friction — fewer manual calls, fewer escalations, no wasted trips" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#2e5a2e;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="700" y="872" width="590" height="96" as="geometry"/>
