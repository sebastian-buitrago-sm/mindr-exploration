                <mxCell id="do4" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Sometimes the user drives to the center expecting a removal — and is turned away (no valid work order).&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
