        <mxCell id="R5" value="Manual quote capture&#10;(tied to per-customer vehicle data)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="c1"><mxGeometry x="80" y="440" width="260" height="60" as="geometry" /></mxCell>

