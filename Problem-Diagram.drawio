        <mxCell id="B6" value="Retry later / request&#10;stalls or is dropped" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
