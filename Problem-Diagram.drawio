        </mxCell>
        <mxCell id="B5" value="Update systems, create work order,&#10;notify customer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1090" y="365" width="220" height="70" as="geometry" />
