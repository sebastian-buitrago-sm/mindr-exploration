        <mxCell id="P3" value="⚠ No API / no real-time&#10;availability — must phone the shop" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="120" y="490" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="P4" value="⚠ Center does not answer&#10;(one-and-done → follow-up missed)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="490" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="P5" value="⚠ Must also capture price quote&#10;(depends on vehicle type, manual)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="490" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="P6" value="⚠ Eligibility / state-paperwork&#10;cases mixed in — not all automatable" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="490" width="220" height="70" as="geometry" />
