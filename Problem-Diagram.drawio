        <mxCell id="hImpact" value="BUSINESS IMPACT" style="text;html=1;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="c1"><mxGeometry x="560" y="30" width="260" height="30" as="geometry" /></mxCell>

        <mxCell id="R1" value="No integration with service centers&#10;(no API / no real-time availability)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="c1"><mxGeometry x="80" y="80" width="260" height="60" as="geometry" /></mxCell>
