<mxfile host="app.diagrams.net" version="24.0.0" type="device">
  <diagram name="Current-State Flow" id="flow-1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Lane backgrounds -->
        <mxCell id="laneCust" value="CUSTOMER" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#333333;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1320" height="260" as="geometry" />
        </mxCell>
        <mxCell id="laneIxl" value="INTOXALOCK CX AGENT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#333333;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="1320" height="420" as="geometry" />
        </mxCell>
        <mxCell id="laneSc" value="INDEPENDENT SERVICE CENTER (mom &amp; pop)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#333333;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="1320" height="220" as="geometry" />
        </mxCell>

        <!-- Start -->
        <mxCell id="start" value="Restriction / lock period ends&#10;→ customer eligible to remove device" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="20" width="300" height="40" as="geometry" />
        </mxCell>

        <!-- Customer lane nodes -->
        <mxCell id="A1" value="Submits Device Removal Request&#10;(App form OR Phone)&#10;date/time, eligibility, contact method" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="120" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="P1" value="⚠ Submitted at impractical time&#10;or when center is closed&#10;(e.g. 10pm for an 8am slot)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="120" y="240" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="P2" value="⚠ Customer believes the request&#10;IS a confirmed appointment" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="240" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="A2" value="Customer shows up&#10;at service center" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1110" y="130" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- Intoxalock lane nodes -->
        <mxCell id="B1" value="Request received &amp; queued&#10;(NOT a confirmed appointment)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="370" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="B2" value="Agent manually&#10;picks up request" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="370" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="B3" value="Agent calls service center&#10;to check availability" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="370" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="B4" value="Appointment&#10;confirmed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
