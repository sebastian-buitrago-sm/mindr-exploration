                </mxCell>
                <mxCell id="intakeNote" value="&lt;b&gt;Validation moved out of the machine:&lt;/b&gt; range &amp; lead-time validation runs in the API intake-handler &lt;b&gt;before&lt;/b&gt; StartExecution — the form gives instant feedback and invalid requests never become executions." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0C068;fontColor=#7a5a10;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" parent="1" vertex="1">
