                <mxCell id="legL5" value="&lt;b&gt;(.waitForTaskToken)&lt;/b&gt; — execution pauses for an&#xa;external event (page click / SMS reply); resumed&#xa;via SendTaskSuccess. Races a per-chunk timeout." style="text;html=1;align=left;fontSize=11;fontColor=#5a5a5a;spacingTop=0;" parent="1" vertex="1">
                    <mxGeometry x="78" y="240" width="304" height="52" as="geometry"/>
                </mxCell>

                <!-- ===== FUNCTION INVENTORY ===== -->
                <mxCell id="funcNote" value="&lt;b&gt;Deployed Lambda functions (consolidated) — card fill = same function&lt;/b&gt;&#xa;&lt;span style='background-color:#FFE9D6'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; &lt;b&gt;send-message&lt;/b&gt; — 8 states, ONE function: consent check → template → audit log&#xa;&lt;span style='background-color:#DDEBF9'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; &lt;b&gt;escalate-to-rep&lt;/b&gt; — 2 states, one function: ticket + full history&#xa;&lt;span style='background-color:#DFF0E0'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; &lt;b&gt;generate-work-order&lt;/b&gt; — 1 state: isolated IAM &amp; alarms&#xa;(+ intake-handler at the API, pre-execution.&#xa;White/purple cards = no Lambda: Choice, Wait, DynamoDB token storage.)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FbFcfd;strokeColor=#C9D1D9;dashed=1;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="60" y="340" width="330" height="140" as="geometry"/>
