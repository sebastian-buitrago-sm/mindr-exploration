<mxfile host="65bd71144e">
    <diagram name="Removal Scheduling - Simplified Flow" id="sol-flow-simple">
        <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="1040" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Intoxalock Device Removal — how a request becomes a reliably-confirmed appointment" style="text;html=1;fontSize=17;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="40" y="18" width="1340" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="Read top to bottom. Green is the happy path; orange is the &quot;needs another step&quot; branch; the notes on the right show what this fixes versus today." style="text;html=1;fontSize=12;fontStyle=2;align=center;fontColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="40" y="46" width="1340" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="band1" value="PHASE 1 · REQUEST INTAKE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3fb;strokeColor=#b3c6e0;verticalAlign=top;align=left;fontStyle=1;fontSize=13;fontColor=#3b5b8c;spacingLeft=14;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="30" y="80" width="1060" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="band2" value="PHASE 2 · AUTOMATED CONFIRMATION" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf6ea;strokeColor=#aacfa6;verticalAlign=top;align=left;fontStyle=1;fontSize=13;fontColor=#2e7d32;spacingLeft=14;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="30" y="310" width="1060" height="490" as="geometry"/>
                </mxCell>
                <mxCell id="band3" value="PHASE 3 · AS THE DATE APPROACHES" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#cccccc;verticalAlign=top;align=left;fontStyle=1;fontSize=13;fontColor=#555555;spacingLeft=14;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="30" y="800" width="1060" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="p1a" value="Customer submits a removal request&#10;App · SMS · AI Voice (AI-disclosed up front)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="380" y="110" width="330" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="p1b" value="Normalized into ONE canonical Removal Request&#10;eligibility + two 2-hour preferred time ranges" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="380" y="178" width="330" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="p1c" value="Eligibility Gate&#10;past lock period &amp; no state paperwork?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="400" y="244" width="290" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="p1ack" value="Acknowledgment to customer:&#10;&quot;Request received — NOT a confirmed appointment&quot;&#10;(+ an update every ~24h until it is)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;dashed=1;fontSize=11;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="45" y="178" width="300" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p1branch" value="Paperwork / ineligible&#10;→ routed to an Intoxalock Rep&#10;(tracked, with reminders)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="760" y="246" width="300" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="p2a" value="Contact the assigned Service Center&#10;Confirmation Page — signed, data-minimized link" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="380" y="335" width="330" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="ladder" value="Confirmation Ladder (enforced, finishes BEFORE the requested slot)&#10;follow-up  →  AI voice call  →  human rep&#10;no &quot;one-and-done&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5fbf4;strokeColor=#82b366;dashed=1;fontSize=11;fontStyle=2;fontColor=#2e7d32;arcSize=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="380" y="403" width="330" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="p2b" value="Center pins an exact hour inside a requested range&#10;(+ quote, observations)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="380" y="485" width="330" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="p2c" value="Work Order issued in Intoxalock's system of record&#10;— the gate —  if it fails, escalate; never say &quot;confirmed&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="380" y="553" width="330" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="p2d" value="ONLY NOW: customer told &quot;CONFIRMED&quot;&#10;date · time · center location" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b9e0b4;strokeColor=#2e7d32;fontSize=12;fontStyle=1;fontColor=#1f5520;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="380" y="625" width="330" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="p2branch" value="Center DECLINES&#10;→ proposes held alternative times (short TTL)&#10;→ customer accepts one = CONFIRMED&#10;   (no return trip to the center)&#10;→ customer silent / TTL expires → human rep" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;arcSize=10;" parent="1" vertex="1">
                    <mxGeometry x="760" y="485" width="300" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p3a" value="If CONFIRMED:&#10;Appointment Reminder ~12h before&#10;(time + center location)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="380" y="835" width="330" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="p3b" value="If STILL UNCONFIRMED near the requested date:&#10;&quot;You do NOT have a confirmed appointment — do not go to the center&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontColor=#8a322f;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="380" y="915" width="330" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="fix1" value="✓ FIXED — paperwork &amp; ineligible cases go to a human BEFORE automation, and stay tracked with reminders so they can't silently stall." style="shape=note;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#2e5a2e;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;size=14;" parent="1" vertex="1">
                    <mxGeometry x="1130" y="232" width="260" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="fix2" value="✓ FIXED — the Work Order is issued in the system of record BEFORE the customer is told &quot;confirmed.&quot; No work order → not confirmed → never turned away at the shop." style="shape=note;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#2e5a2e;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;size=14;" parent="1" vertex="1">
                    <mxGeometry x="1130" y="540" width="260" height="98" as="geometry"/>
                </mxCell>
                <mxCell id="fix3" value="✓ FIXED — every branch ends in a Confirmed Appointment or a human handoff. Center silence AND customer silence both have bounded timeouts." style="shape=note;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#2e5a2e;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;size=14;" parent="1" vertex="1">
                    <mxGeometry x="1130" y="900" width="260" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="e1" style="html=1;endArrow=block;startArrow=none;rounded=0;fontSize=11;edgeStyle=orthogonalEdgeStyle;" parent="1" source="p1a" target="p1b" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" style="html=1;endArrow=block;startArrow=none;rounded=0;fontSize=11;edgeStyle=orthogonalEdgeStyle;" parent="1" source="p1b" target="p1c" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2ack" style="html=1;endArrow=open;startArrow=none;rounded=0;dashed=1;fontSize=11;strokeColor=#6c8ebf;" parent="1" source="p1b" target="p1ack" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3branch" value="no" style="html=1;endArrow=block;startArrow=none;rounded=0;dashed=1;fontSize=11;strokeColor=#d79b00;fontColor=#a9761a;labelBackgroundColor=#eef3fb;" parent="1" source="p1c" target="p1branch" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3" value="yes → automate" style="html=1;endArrow=block;startArrow=none;rounded=0;fontSize=11;fontColor=#2e7d32;labelBackgroundColor=#eaf6ea;edgeStyle=orthogonalEdgeStyle;" parent="1" source="p1c" target="p2a" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4" style="html=1;endArrow=block;startArrow=none;rounded=0;fontSize=11;edgeStyle=orthogonalEdgeStyle;" parent="1" source="p2a" target="ladder" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e5" value="center confirms" style="html=1;endArrow=block;startArrow=none;rounded=0;fontSize=11;fontColor=#2e7d32;labelBackgroundColor=#eaf6ea;edgeStyle=orthogonalEdgeStyle;" parent="1" source="ladder" target="p2b" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e5branch" value="declines" style="html=1;endArrow=block;startArrow=none;rounded=0;dashed=1;fontSize=11;strokeColor=#d79b00;fontColor=#a9761a;labelBackgroundColor=#eaf6ea;" parent="1" source="ladder" target="p2branch" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e6" style="html=1;endArrow=block;startArrow=none;rounded=0;fontSize=11;edgeStyle=orthogonalEdgeStyle;" parent="1" source="p2b" target="p2c" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e7" style="html=1;endArrow=block;startArrow=none;rounded=0;fontSize=11;edgeStyle=orthogonalEdgeStyle;" parent="1" source="p2c" target="p2d" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e7branch" value="accepted = confirmed" style="html=1;endArrow=block;startArrow=none;rounded=0;fontSize=11;fontColor=#2e7d32;labelBackgroundColor=#eaf6ea;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="p2branch" target="p2d" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e8" style="html=1;endArrow=block;startArrow=none;rounded=0;fontSize=11;edgeStyle=orthogonalEdgeStyle;" parent="1" source="p2d" target="p3a" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ef1" style="html=1;endArrow=none;startArrow=none;rounded=0;dashed=1;strokeColor=#aacfa6;" parent="1" source="p1branch" target="fix1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ef2" style="html=1;endArrow=none;startArrow=none;rounded=0;dashed=1;strokeColor=#aacfa6;" parent="1" source="p2c" target="fix2" edge="1">
