        <mxGraphModel dx="1211" dy="-193" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="vhp_36uCfPpzbG6TCI_Z-1" value="&lt;b&gt;📚 SOURCES&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Why SMS and app intake beat phone calls:&lt;/b&gt; 74% of Americans do not answer calls from unknown numbers for fear of scams, and 80% block them — &lt;a href=&quot;https://newsroom.transunion.com/nearly-80-of-consumers-consider-phone-channel-important-for-communicating-with-businesses-despite-reluctance-to-answer-calls/&quot;&gt;TransUnion survey, 2024&lt;/a&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;SMS is comparable to automated calls (and more cost-effective):&lt;/b&gt; SMS reminders match phone calls for boosting attendance (SMS RR 1.14 vs telephone RR 1.11) — &lt;a href=&quot;https://jhmhp.amegroups.org/article/view/10215/html&quot;&gt;Systematic review &amp;amp; meta-analysis, J Hosp Manag Health Policy, 2026&lt;/a&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Reminders sharply cut no-shows:&lt;/b&gt; appointment reminders raise attendance ~11% (RR 1.11) across 10 trials and 8,236 patients — &lt;a href=&quot;https://jhmhp.amegroups.org/article/view/10215/html&quot;&gt;Meta-analysis, 2026&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5fbf4;strokeColor=#cbe3c6;verticalAlign=top;align=left;fontSize=11;fontColor=#2e5a2e;spacingLeft=14;spacingTop=8;spacingRight=14;dashed=1;" vertex="1" parent="1">
                    <mxGeometry x="30" y="1345" width="1450" height="150" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
