                <mxCell id="GN1" value="✓ FIXED — Eligibility Gate routes paperwork / ineligible cases to a human BEFORE automation, and keeps tracking them with reminders so they can't silently stall." style="shape=note;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#2e5a2e;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;size=14;" parent="1" vertex="1">
                    <mxGeometry x="900" y="178" width="300" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="GN2" value="✓ FIXED — Work Order is issued in the system of record BEFORE the customer is told &quot;confirmed.&quot; No work order → not confirmed → never turned away at the shop." style="shape=note;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#2e5a2e;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;size=14;" parent="1" vertex="1">
