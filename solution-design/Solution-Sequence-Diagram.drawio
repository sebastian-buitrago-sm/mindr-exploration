                <mxCell id="GN1" value="✓ FIXED — the Eligibility Gate routes paperwork / ineligible cases to a human BEFORE automation, and keeps tracking them with reminders so they can&#39;t silently stall." style="shape=note;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#2e5a2e;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;size=14;" parent="1" vertex="1">
