                <mxCell id="own-e-wo" value="generate Work Order" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;fontColor=#5a5a5a;labelBackgroundColor=#eef3fb;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="own-receiver" target="own-wo" edge="1">
