                    </mxGeometry>
                </mxCell>
                <mxCell id="channel-refs-note" value="&lt;b&gt;Why SMS + email is the first touch and voice is an escalation rung — US research&lt;/b&gt;&lt;br&gt;&lt;br&gt;Most Americans don&#39;t answer calls from unknown numbers [1][2], and small businesses miss ~62% of inbound calls [3]. SMS lets the recipient reply when available and leaves a written record — so the design sends SMS + email first (rung 1) and uses an AI voice call only as a later escalation rung. &lt;i&gt;Limitation: available sources cover consumers and general SMBs, not B2B outreach to service centers, and are several years old; the pilot will measure our own per-channel response rates.&lt;/i&gt;&lt;br&gt;&lt;br&gt;1. &lt;a href=&quot;https://www.pewresearch.org/short-reads/2020/12/14/most-americans-dont-answer-cellphone-calls-from-unknown-numbers/&quot;&gt;Pew Research Center (2020) — Most Americans don&#39;t answer cellphone calls from unknown numbers&lt;/a&gt; — national survey; consumers&#39; personal phones only.&lt;br&gt;2. &lt;a href=&quot;https://tnsi.com/resource/com/tns-survey-75-americans-will-never-answer-calls-from-unknown-numbers-press-release/&quot;&gt;TNS / Kantar (2022) — 75% of Americans will never answer calls from unknown numbers&lt;/a&gt; — US survey of 1,000+ adults; industry-commissioned.&lt;br&gt;3. &lt;a href=&quot;https://411locals.us/small-business-owners-dont-answer-62-of-phone-calls/&quot;&gt;411 Locals — SMBs don&#39;t answer 62% of phone calls&lt;/a&gt; — vendor-run, 85 businesses; directional support only.&lt;br&gt;4. &lt;a href=&quot;https://tabular.email/blog/sms-marketing-stats&quot;&gt;Tabular — SMS marketing stats&lt;/a&gt; — not relied on as evidence: a vendor marketing roundup that aggregates second-hand stats (e.g. the &amp;quot;295% higher response rate&amp;quot; figure) without methodology; included only as an example of the widely circulated claims this note does not use." style="shape=note;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a3a5c;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;size=18;" parent="1" vertex="1">
                    <mxGeometry x="180" y="1810" width="1100" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="channel-refs-link" style="html=1;endArrow=none;startArrow=none;dashed=1;strokeColor=#6c8ebf;rounded=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="channel-refs-note" target="ClpyBZq0yxFKyI8LTP0s-26" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
